<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>tv-icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 不生成 .pdb 调试文件 -->
    <DebugType>none</DebugType>
    <!-- 只保留 .pdb 关联文件（避免复制 .xml 文档） -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <!-- 启用单文件压缩 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 只包含中文资源，减小体积 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 跳过 workload 包缺失检查（Android workload 已卸载） -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- Wasmtime 已移除: WasmSigner (C# 侧签名) 是死代码, 签名早已全部由页面内 keygen_bg.wasm 完成。
         该包会带进 wasmtime.dll(8.73MB) + Wasmtime.Dotnet.dll(614KB)。源码保留在 legacy/WasmSigner.cs。 -->
  </ItemGroup>

  <!-- legacy/: 仅供分析/回溯的历史代码, 不参与编译 -->
  <ItemGroup>
    <Compile Remove="legacy/**" />
    <None Include="legacy/**" />
  </ItemGroup>

  <!-- 伴生文件（调试和发布都复制） -->
  <ItemGroup>
    <Content Include="player.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="tv-icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="keygen_bg.wasm" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="RJq7sO71JF.wasm" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="ts_module_body.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="gen_yspticket.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    
    <!-- ★ 使用宏明确路径 ★ cctv-proxy.exe: 调试输出需要; 发布由 publish.ps1 单独复制, 不进 publish 目录 -->
    <Content Include="$(MSBuildProjectDirectory)\..\cctv-proxy\cctv-proxy.exe"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="Never"
            Link="cctv-proxy.exe" />

    <!-- ★ 代理缓存: 播放必需的四件套 (slim 解密三件套 + 官方 hls.cmg.js)。
         cmg.worker.js(1.30MB) 已由 slim 取代、页面从不请求, 不再随行。
         注意: slim 三件套是本地生成产物(rev/gen_slim.cjs), 上游不存在, 代理缓存未命中会 404。 -->
    <Content Include="$(MSBuildProjectDirectory)\..\cctv-proxy\sapi_cache\assets_2025_wasm_cmg.slim.js"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="Never"
            Link="sapi_cache\assets_2025_wasm_cmg.slim.js" />
    <Content Include="$(MSBuildProjectDirectory)\..\cctv-proxy\sapi_cache\assets_2025_wasm_eb_prog.bin"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="Never"
            Link="sapi_cache\assets_2025_wasm_eb_prog.bin" />
    <Content Include="$(MSBuildProjectDirectory)\..\cctv-proxy\sapi_cache\assets_2025_wasm_reloc_table.bin"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="Never"
            Link="sapi_cache\assets_2025_wasm_reloc_table.bin" />
    <Content Include="$(MSBuildProjectDirectory)\..\cctv-proxy\sapi_cache\assets_2025_wasm_hls.cmg.js"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="Never"
            Link="sapi_cache\assets_2025_wasm_hls.cmg.js" />
  </ItemGroup>
</Project>
